
<!doctype html>


<html lang="ja">


<head>
  <!-- Required meta tags -->
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600&display=swap"> 

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">

  <link rel="stylesheet" href="/static/zTree_v3/css/zTreeStyle/zTreeStyle.css" type="text/css">
<style>
html, body{
    height:100%;
    margin:0;
}

body{
    display:flex;
    flex-direction:column;
}

.header_panel{
  height:50px;
  background:#ddd;
  margin-bottom: 10px;
  padding-left: 50px;
}

.main_panel{
  height: calc(100% - 120px);
  width:80%;
  margin:auto;
  display: flex;
  flex-direction: row;
}

.main_panel .treeview_wrapper{
  height: 100%;
  padding: 20px;
  width: calc(100% - 200px);
  border: 1px solid grey;
  margin-right: 20px;
  display: flex;
  flex-direction: column;
}

.main_panel .treeview_wrapper .upper{
  height: 40px;
  width:  100%;
}

.main_panel .treeview_wrapper .upper input{width: 500px; margin-right: 10px;}

.main_panel .treeview_wrapper .down{
  height: calc(100% - 40px);
  width: 100%;
  border: 1px solid grey;
  overflow: auto;
}

.main_panel .control_wrapper{
  height: 100%;
  width: 180px;
  border: 1px solid grey;
  padding-left: 10px;
  padding-right: 10px;
}

.main_panel .control_wrapper > div{
  width: 100%;
  margin-top: 10px;
}

.main_panel .control_wrapper > div > button {
  width: 100%;
  border-radius: 5px;
  background-color: white;
  text-align: left;
  padding-bottom: 5px;
}
.main_panel .control_wrapper > div > button:hover{background: #ccc;}

.foot_panel{
  margin-top: 10px;
  height:50px;
  background:#ddd;
  padding-left: 50px;
}
.ztree li a.curSelectedNode {background-color: #f3ecdd;}
.ztree * { font-size: 16px;}
.ztree li {margin-bottom: 5px;}
.ztree li ul {margin-top: 5px;}
.highlight-node > a {
    background-color: #fff3cd !important;
    color: #d63384 !important;
    font-weight: bold !important;
}

.num{ color: #787878; }

.nando-id,.version{
  border: 1px solid black;
  padding-left: 10px; 
  padding-right: 10px;
  margin-left: 20px; 
  margin-right: 20px;
  border-radius: 10px;
}

.link-svg{
    
    margin-left: 10px;

    border: 0px;
    width:  20px;
    height: 20px;
    color: #1B2C1A;
    background-color: #FFF;
    background-image: url(data:image/svg+xml,%3C%3Fxml%20version%3D%221.0%22%20encoding%3D%22utf-8%22%3F%3E%3C!--%20License%3A%20MIT.%20Made%20by%20halfmage%3A%20https%3A%2F%2Fgithub.com%2Fhalfmage%2Fmajesticons%20--%3E%3Csvg%20width%3D%2216px%22%20height%3D%2216px%22%20viewBox%3D%220%200%2024%2024%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%3E%3Cpath%20stroke%3D%22currentcolor%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%222%22%20d%3D%22M10%204H6a2%202%200%200%200-2%202v12a2%202%200%200%200%202%202h12a2%202%200%200%200%202-2v-4m-8-2%208-8m0%200v5m0-5h-5%22%2F%3E%3C%2Fsvg%3E);
    background-size: contain;
    background-repeat: no-repeat;

}

.link-svg:hover{
  background-color: #ccc;
}



</style>

  <title>PanelSearch(nanbyo) : Treeview</title>
  
</head>

<body>
  <div class="header_panel"><h1>PanelSearch Nanbyo Treeview</h1></div>
  <div class="main_panel">
    <div class="treeview_wrapper">
      <div class="upper">
        <input id="searchText" type="text" /><button id="btnSearch">Search</button>
      </div>
      <div class="down"><ul id="treeView" class="ztree"></ul></div>
    </div>
    <div class="control_wrapper d-flex flex-column">
		<div><button id="btnExpandAll">Expand All</button></div>
		<div><button id="btnCollapseAll">Collapse All</button></div>
		<div><button id="btnExpandNode">Expand Node</button></div>
        <div><button id="btnCollapseNode">Collapse Node</button></div>
		<div><button id="btnCopy" data-toggle="tooltip" data-trigger="manual" title="Copied!">Copy</button></div>
		<div><button id="btnPaste" data-toggle="tooltip" data-trigger="manual" title="Copied!">Paste</button></div>
	</div>
  </div>
  <div class="foot_panel"><h3></h3></div>
</body>


<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous"></script>


<script type="text/javascript" src="/static/zTree_v3/js/jquery.ztree.core.js"></script>
<script type="text/javascript" src="/static/zTree_v3/js/jquery.ztree.excheck.js"></script>
<script type="text/javascript" src="/static/zTree_v3/js/jquery.ztree.exedit.js"></script>
<script type="text/javascript" src="/static/js/panelsearch_nanbyo/utils.js"></script>

<SCRIPT LANGUAGE="JavaScript">

function _attach_display_name(version_hash, treeview_data, depth){
    
	let version = version_hash[treeview_data.nando_id];

	if(['ALL','NANDO:0000003','UNSPECIFIED'].includes(treeview_data.panel_id) === false){
		if(depth >= 2 && depth <= 3){
        	treeview_data['displayName'] += `
            	<span class="version">ver:${version}</span>
        	`;
    	}
		treeview_data['displayName'] += `
			<svg class="link-svg" data-nando_id="${treeview_data.panel_id}" title="Jump to Panel Detail Page(${treeview_data.panel_id})"></svg>
		`;
	}

	if('children' in treeview_data && treeview_data.children.length > 0){
		for(let sub_treeview_data of treeview_data.children){
			_attach_display_name(version_hash, sub_treeview_data, depth + 1);
		}
	}
}

var zTreeObj;
function _init_treeview(version_hash, treeview_data){

    let is_attach_descendant_cnt = true;
    let isFirstTimeLoad = false;
    utils_create_treeview_data_from_ontology(
        treeview_data, 'ja', is_attach_descendant_cnt, isFirstTimeLoad
    );

    // set the level-0 expanded
    treeview_data["open"] = true;
    for(let child of treeview_data.children){
        // set the level-1 expanded
        child["open"] = true;
    }

	_attach_display_name(version_hash, treeview_data, 0);

	zTreeObj = $.fn.zTree.init($("#treeView"), {
		view: {
			selectedMulti:  false,
			fontCss: getFontCss,
			nameIsHTML: true
		},
		edit: {
			showRemoveBtn:  false,
			showRenameBtn:  false,
			enable: true,
			drag: {
				isCopy: true,
				isMove: true,
				prev:   true,
				inner:  true,
				next:   true,
			}
		},
		callback:{
			beforeDrag: beforeDrag,
			beforeDrop: beforeDrop
		},
		data: { key: {name: "displayName", title: "nando_id"}  }
	}, [treeview_data]);


	$(document).on("click", ".link-svg", function(e){
		e.stopPropagation();
		let $tag = $(this);
		let nando_id=$tag.data('nando_id');
		let urlstr = `/panelsearch_nanbyo_panel_detail?panel_id=${nando_id}&nando_id=${nando_id}&lang=ja`;
		window.open(urlstr, "_blank");
	});

}

function getFontCss(treeId, treeNode) {

    switch(treeNode.level) {

        case 2:
            return {
                color: "#ff0000",
                "font-weight": "bold"
            };

        case 3:
            return {
                color: "#0066ff",
                "font-weight": "bold"
            };

        default:
            if (treeNode.level >= 4) {
                return {
                    color: "#bc8d12"
                };
            }
            return {};
    }
}


function beforeDrag(treeId, treeNodes){
	for(let i=0, l=treeNodes.length;i<l; i++){
		if(treeNodes[i].drag === false){
			return false;
		}
	}
	return true;
}

function beforeDrop(treeId, treeNodes, targetNode, moveType){
	return targetNode ? targetNode.drop !== false: true;
}


function expandSubTree(treeObj, node) {

    treeObj.expandNode(
        node,
        true,   // expandFlag
        false,  // sonSign
        false,  // focus
        false   // callbackFlag
    );

    if (node.children) {
        node.children.forEach(function(child) {
            expandSubTree(treeObj, child);
        });
    }
}

var clipboardNode = null;

function isDescendant(node, targetId) {

    if (!node.children) {
        return false;
    }

    for (let child of node.children) {

        if (child.panel_id == targetId) {
            return true;
        }

        if (isDescendant(child, targetId)) {
            return true;
        }
    }

    return false;
}

function cloneSubtree(node) {

    let clone = {
        name: node.name,
		panel_id: node.panel_id
    };

    if (node.children && node.children.length > 0) {

        clone.children = node.children.map(
            child => cloneSubtree(child)
        );
    }

    return clone;
}

function containsNode(root, targetId) {

    if (root.panel_id == targetId) {
        return true;
    }

    if (!root.children) {
        return false;
    }

    for (const child of root.children) {

        if (containsNode(child, targetId)) {
            return true;
        }
    }

    return false;
}

function searchNode(keyword) {

    // 清除旧高亮
    clearHighlight(zTreeObj);

    if (!keyword) {
        return;
    }

    var result = zTreeObj.getNodesByParamFuzzy("display_name", keyword, null);


    if (!result || result.length === 0) {
        alert("Not found");
        return;
    }

	for(let node of result){
	    highlightNode(zTreeObj, node);
	}
}

function highlightNode(treeObj, node) {

    // 展开父节点
    var parent = node.getParentNode();

    while (parent) {
        treeObj.expandNode(parent, true, false, false);
        parent = parent.getParentNode();
    }

    // 增加class
    $("#" + node.tId)
        .addClass("highlight-node");

    // 选中
    treeObj.selectNode(node);

    // 滚动到可见区域
    document.getElementById(node.tId)
        .scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
}
function clearHighlight(treeObj) {

    var nodes = treeObj.transformToArray(treeObj.getNodes());

    $.each(nodes, function (_, node) {
        $("#" + node.tId)
            .removeClass("highlight-node");
    });
}

$(document).ready(function(){

	fetch('/panelsearch_nanbyo_get_all_panel_version')
	.then(response1 => response1.json())
	.then(data1 => {
		fetch('/panelsearch_nanbyo_get_treeview')
		.then(response => response.json())
		.then(data => {
			_init_treeview(data1, data);
		});
	});
	$('#btnExpandAll').click(function(){
		zTreeObj.expandAll(true);
	});

    // add a button to collapse all nodes
    $('#btnCollapseAll').click(function(){
        zTreeObj.expandAll(false);
    });

	$('#btnExpandNode').click(function(){

		var selectedNodes = zTreeObj.getSelectedNodes();

		if (selectedNodes.length > 0) {
			var node = selectedNodes[0];

			expandSubTree(zTreeObj, node);

		} else {

			alert('Select a node first!');
		}
	});

    // add a button to collapse selected node
    $('#btnCollapseNode').click(function(){
        var selectedNodes = zTreeObj.getSelectedNodes();

        if (selectedNodes.length > 0) {
            var node = selectedNodes[0];

            zTreeObj.expandNode(node, false, false, false, false);

        } else {

            alert('Select a node first!');
        }
    });

$("#btnSearch").click(function () {
    searchNode($("#searchText").val().trim());
});

$('#btnCopy').tooltip();
$("#btnCopy").click(function () {

    var nodes = zTreeObj.getSelectedNodes();

    if (nodes.length === 0) {
        alert("Please select node to be copied.");
        return;
    }

    clipboardNode = nodes[0];

	 $(this).attr('data-original-title', '[ ' + clipboardNode.name + ' ] was copied')
            .tooltip('show');

        setTimeout(() => {
            $(this).tooltip('hide');
        }, 1500);
    console.log("Copied:", clipboardNode.id);
});

$('#btnPaste').tooltip();
$("#btnPaste").click(function () {

    if (!clipboardNode) {
        alert("Copy first!");
        return;
    }

    var nodes = zTreeObj.getSelectedNodes();

    if (nodes.length === 0) {
        alert("Please select the parent node!");
        return;
    }

    var targetParent = nodes[0];

    //
    // 自己贴到自己下面
    //
    if (targetParent.panel_id == clipboardNode.panel_id) {

        alert("Canot do cycle paste!");
        return;
    }

    //
    // 环检测
    //
    if (isDescendant(clipboardNode, targetParent.panel_id)) {

        alert("Will create cycle, Stop Paste!");
        return;
    }

    //
    // 重复关系检测
    //
    if (targetParent.children) {

        var exists = targetParent.children.some(
            c => c.panel_id == clipboardNode.panel_id
        );

        if (exists) {
            alert("The relation already exists!");
            return;
        }
    }

if (
    containsNode(
        clipboardNode,
        targetParent.parent_id
    )
) {
    alert("Stop due to there will be Cycle after paste!");
    return;
}

    //
    // UI增加节点
    //
	var copiedTree = cloneSubtree(clipboardNode);
    zTreeObj.addNodes( targetParent, copiedTree );

    $(this).attr('data-original-title', `[ ${copiedTree.name} ] was copied below [ ${targetParent.name} ]`)
           .tooltip('show');

        setTimeout(() => { $(this).tooltip('hide');}, 1500);

	clipboardNode = null;
	zTreeObj.cancelSelectedNode(targetParent);
});


 });
</SCRIPT>

</html>
